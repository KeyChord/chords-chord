#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/work/chords/chords/node_modules/.pnpm/@keychord+config@0.0.9/node_modules/@keychord/config/node_modules:/home/runner/work/chords/chords/node_modules/.pnpm/@keychord+config@0.0.9/node_modules:/home/runner/work/chords/chords/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/work/chords/chords/node_modules/.pnpm/@keychord+config@0.0.9/node_modules/@keychord/config/node_modules:/home/runner/work/chords/chords/node_modules/.pnpm/@keychord+config@0.0.9/node_modules:/home/runner/work/chords/chords/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/bun" ]; then
  exec "$basedir/bun"  "$basedir/../@keychord/config/exports/compile.js" "$@"
else
  exec bun  "$basedir/../@keychord/config/exports/compile.js" "$@"
fi
